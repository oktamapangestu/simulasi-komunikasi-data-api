{
  "info": {
    "name": "Perpustakaan API - Komunikasi Data",
    "description": "Studi kasus CRUD buku perpustakaan untuk REST, SOAP, dan GraphQL.\n\nJalankan server di folder masing-masing (`npm install && npm start`), lalu jalankan setiap folder di collection ini secara berurutan, atau sekaligus lewat **Run collection**.\n\ngRPC dan WebSocket tidak bisa dimasukkan ke file collection. Panduan menguji keduanya di Postman ada di `postman/README.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "rest_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "soap_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "graphql_url",
      "value": "http://localhost:4000"
    },
    {
      "key": "bukuIdRest",
      "value": "4"
    },
    {
      "key": "bukuIdSoap",
      "value": "4"
    },
    {
      "key": "bukuIdGraphql",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "REST API",
      "description": "Server: `REST_API` (port 3000). Jalankan `npm start` di folder REST_API.\n\nJalankan request berurutan dari atas: request **Tambah buku** menyimpan id buku baru ke variabel `bukuIdRest`, yang dipakai request setelahnya.",
      "item": [
        {
          "name": "1. Ambil semua buku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('data berupa array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rest_url}}/api/buku",
            "description": "READ semua buku. Method GET tanpa body."
          }
        },
        {
          "name": "2. Tambah buku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const id = pm.response.json().data.id;",
                  "pm.collectionVariables.set('bukuIdRest', id);",
                  "pm.test('id buku baru tersimpan: ' + id, () => pm.expect(id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Ronggeng Dukuh Paruk\",\n  \"penulis\": \"Ahmad Tohari\",\n  \"penerbit\": \"Gramedia\",\n  \"tahunTerbit\": 1982,\n  \"isbn\": \"9789792223477\",\n  \"stok\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{rest_url}}/api/buku",
            "description": "CREATE buku baru. Server membalas 201 Created. Id buku baru disimpan ke variabel `bukuIdRest`."
          }
        },
        {
          "name": "3. Ambil satu buku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('judul sesuai', () => pm.expect(pm.response.json().data.judul).to.eql('Ronggeng Dukuh Paruk'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rest_url}}/api/buku/{{bukuIdRest}}",
            "description": "READ satu buku berdasarkan id di URL."
          }
        },
        {
          "name": "4. Ubah buku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stok menjadi 10', () => pm.expect(pm.response.json().data.stok).to.eql(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stok\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{rest_url}}/api/buku/{{bukuIdRest}}",
            "description": "UPDATE: cukup kirim field yang ingin diubah."
          }
        },
        {
          "name": "5. Hapus buku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{rest_url}}/api/buku/{{bukuIdRest}}",
            "description": "DELETE buku. Server mengembalikan data buku yang dihapus."
          }
        },
        {
          "name": "6. Error: buku tidak ditemukan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('status gagal', () => pm.expect(pm.response.json().status).to.eql('gagal'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rest_url}}/api/buku/{{bukuIdRest}}",
            "description": "Buku sudah dihapus, jadi server membalas 404 Not Found."
          }
        },
        {
          "name": "7. Error: validasi gagal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('ada daftar errors', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Buku tanpa data lengkap\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{rest_url}}/api/buku",
            "description": "Field wajib tidak lengkap, jadi server membalas 400 Bad Request beserta daftar error."
          }
        }
      ]
    },
    {
      "name": "SOAP API",
      "description": "Server: `SOAP_API` (port 8000). Semua operasi dikirim dengan POST ke satu endpoint `/soap/perpustakaan`. Operasi ditentukan oleh elemen di dalam `soapenv:Body` dan header `SOAPAction`.\n\nJalankan berurutan: **CreateBuku** menyimpan id buku baru ke variabel `bukuIdSoap`.",
      "item": [
        {
          "name": "0. Ambil WSDL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('berisi 5 operasi', () => ['GetAllBuku','GetBukuById','CreateBuku','UpdateBuku','DeleteBuku'].forEach(op => pm.expect(pm.response.text()).to.include('operation name=\"' + op + '\"')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{soap_url}}/soap/perpustakaan?wsdl",
            "description": "Mengunduh kontrak layanan (WSDL)."
          }
        },
        {
          "name": "1. GetAllBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ada GetAllBukuResponse', () => pm.expect(pm.response.text()).to.include('GetAllBukuResponse'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://perpustakaan.example.com/buku/GetAllBuku\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:buk=\"http://perpustakaan.example.com/buku\">\n  <soapenv:Body>\n    <buk:GetAllBukuRequest/>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{soap_url}}/soap/perpustakaan",
            "description": "READ semua buku."
          }
        },
        {
          "name": "2. CreateBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.text().match(/<buku>\\s*<id>(\\d+)<\\/id>/);",
                  "pm.test('id buku baru ada di respons', () => pm.expect(m).to.not.be.null);",
                  "if (m) pm.collectionVariables.set('bukuIdSoap', m[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://perpustakaan.example.com/buku/CreateBuku\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:buk=\"http://perpustakaan.example.com/buku\">\n  <soapenv:Body>\n    <buk:CreateBukuRequest>\n      <buk:judul>Ronggeng Dukuh Paruk</buk:judul>\n      <buk:penulis>Ahmad Tohari</buk:penulis>\n      <buk:penerbit>Gramedia</buk:penerbit>\n      <buk:tahunTerbit>1982</buk:tahunTerbit>\n      <buk:isbn>9789792223477</buk:isbn>\n      <buk:stok>2</buk:stok>\n    </buk:CreateBukuRequest>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{soap_url}}/soap/perpustakaan",
            "description": "CREATE buku baru. Id buku baru diambil dari `<buku><id>` lalu disimpan ke variabel `bukuIdSoap`."
          }
        },
        {
          "name": "3. GetBukuById",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('judul sesuai', () => pm.expect(pm.response.text()).to.include('<judul>Ronggeng Dukuh Paruk</judul>'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://perpustakaan.example.com/buku/GetBukuById\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:buk=\"http://perpustakaan.example.com/buku\">\n  <soapenv:Body>\n    <buk:GetBukuByIdRequest>\n      <buk:id>{{bukuIdSoap}}</buk:id>\n    </buk:GetBukuByIdRequest>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{soap_url}}/soap/perpustakaan",
            "description": "READ satu buku."
          }
        },
        {
          "name": "4. UpdateBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stok menjadi 10', () => pm.expect(pm.response.text()).to.include('<stok>10</stok>'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://perpustakaan.example.com/buku/UpdateBuku\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:buk=\"http://perpustakaan.example.com/buku\">\n  <soapenv:Body>\n    <buk:UpdateBukuRequest>\n      <buk:id>{{bukuIdSoap}}</buk:id>\n      <buk:stok>10</buk:stok>\n    </buk:UpdateBukuRequest>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{soap_url}}/soap/perpustakaan",
            "description": "UPDATE: kirim id dan field yang ingin diubah saja."
          }
        },
        {
          "name": "5. DeleteBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('pesan berhasil dihapus', () => pm.expect(pm.response.text()).to.include('Buku berhasil dihapus'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://perpustakaan.example.com/buku/DeleteBuku\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:buk=\"http://perpustakaan.example.com/buku\">\n  <soapenv:Body>\n    <buk:DeleteBukuRequest>\n      <buk:id>{{bukuIdSoap}}</buk:id>\n    </buk:DeleteBukuRequest>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{soap_url}}/soap/perpustakaan",
            "description": "DELETE buku."
          }
        },
        {
          "name": "6. Error: SOAP Fault",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 500', () => pm.response.to.have.status(500));",
                  "pm.test('berisi soap:Fault', () => pm.expect(pm.response.text()).to.include('<soap:Fault>'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://perpustakaan.example.com/buku/GetBukuById\""
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:buk=\"http://perpustakaan.example.com/buku\">\n  <soapenv:Body>\n    <buk:GetBukuByIdRequest>\n      <buk:id>{{bukuIdSoap}}</buk:id>\n    </buk:GetBukuByIdRequest>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{soap_url}}/soap/perpustakaan",
            "description": "Buku sudah dihapus, jadi server membalas `soap:Fault` dengan HTTP 500."
          }
        }
      ]
    },
    {
      "name": "GraphQL API",
      "description": "Server: `GraphQL_API` (port 4000). Semua operasi dikirim dengan POST ke `/graphql`. Coba ubah daftar field di query untuk melihat respons ikut berubah.\n\nGraphQL tetap membalas HTTP 200 walaupun terjadi error; error ada di array `errors`.\n\nJalankan berurutan: **tambahBuku** menyimpan id buku baru ke variabel `bukuIdGraphql`.",
      "item": [
        {
          "name": "1. Query semuaBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('hanya field yang diminta', () => pm.expect(Object.keys(pm.response.json().data.semuaBuku[0])).to.eql(['id', 'judul']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  semuaBuku {\n    id\n    judul\n  }\n}",
                "variables": ""
              }
            },
            "url": "{{graphql_url}}/graphql",
            "description": "READ semua buku, hanya field id dan judul."
          }
        },
        {
          "name": "2. Mutation tambahBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tanpa errors', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "const id = pm.response.json().data.tambahBuku.id;",
                  "pm.collectionVariables.set('bukuIdGraphql', id);",
                  "pm.test('id buku baru tersimpan: ' + id, () => pm.expect(id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Tambah($input: BukuInput!) {\n  tambahBuku(input: $input) {\n    id\n    judul\n    penulis\n    stok\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"judul\": \"Ronggeng Dukuh Paruk\",\n    \"penulis\": \"Ahmad Tohari\",\n    \"penerbit\": \"Gramedia\",\n    \"tahunTerbit\": 1982,\n    \"isbn\": \"9789792223477\",\n    \"stok\": 2\n  }\n}"
              }
            },
            "url": "{{graphql_url}}/graphql",
            "description": "CREATE buku baru lewat variables. Id buku baru disimpan ke variabel `bukuIdGraphql`."
          }
        },
        {
          "name": "3. Query buku(id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('judul sesuai', () => pm.expect(pm.response.json().data.buku.judul).to.eql('Ronggeng Dukuh Paruk'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Satu($id: Int!) {\n  buku(id: $id) {\n    id\n    judul\n    penulis\n    penerbit\n    tahunTerbit\n    isbn\n    stok\n  }\n}",
                "variables": "{\n  \"id\": {{bukuIdGraphql}}\n}"
              }
            },
            "url": "{{graphql_url}}/graphql",
            "description": "READ satu buku."
          }
        },
        {
          "name": "4. Mutation ubahBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('stok menjadi 10', () => pm.expect(pm.response.json().data.ubahBuku.stok).to.eql(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Ubah($id: Int!, $input: UbahBukuInput!) {\n  ubahBuku(id: $id, input: $input) {\n    id\n    judul\n    stok\n  }\n}",
                "variables": "{\n  \"id\": {{bukuIdGraphql}},\n  \"input\": { \"stok\": 10 }\n}"
              }
            },
            "url": "{{graphql_url}}/graphql",
            "description": "UPDATE: input UbahBukuInput semua field-nya opsional."
          }
        },
        {
          "name": "5. Mutation hapusBuku",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('buku terhapus', () => pm.expect(pm.response.json().data.hapusBuku.judul).to.eql('Ronggeng Dukuh Paruk'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Hapus($id: Int!) {\n  hapusBuku(id: $id) {\n    id\n    judul\n  }\n}",
                "variables": "{\n  \"id\": {{bukuIdGraphql}}\n}"
              }
            },
            "url": "{{graphql_url}}/graphql",
            "description": "DELETE buku."
          }
        },
        {
          "name": "6. Error: NOT_FOUND",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP tetap 200', () => pm.response.to.have.status(200));",
                  "pm.test('kode error NOT_FOUND', () => pm.expect(pm.response.json().errors[0].extensions.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Hapus($id: Int!) {\n  hapusBuku(id: $id) {\n    id\n  }\n}",
                "variables": "{\n  \"id\": {{bukuIdGraphql}}\n}"
              }
            },
            "url": "{{graphql_url}}/graphql",
            "description": "Buku sudah dihapus, jadi resolver melempar error NOT_FOUND. HTTP tetap 200."
          }
        },
        {
          "name": "7. Error: validasi skema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('kode GRAPHQL_VALIDATION_FAILED', () => pm.expect(pm.response.json().errors[0].extensions.code).to.eql('GRAPHQL_VALIDATION_FAILED'));"
                ]
              }
            }
          ],
